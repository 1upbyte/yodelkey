{
  "manifest_version": 3,
  "name": "YodelKey",
  "version": "1.1.0",
  "description": "Share URLs, text, and files with a yodel",
  "permissions": ["activeTab", "clipboardWrite", "tabs"],
  "host_permissions": ["https://yodelkey.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "YodelKey"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "yodelkey@extension",
      "strict_min_version": "109.0"
    }
  }
}
